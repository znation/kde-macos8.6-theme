# Mac OS 8.6 "Platinum" Kvantum widget style for KDE Plasma 6.
#
# Kvantum merges this file over its compiled-in default.kvconfig and draws an
# element the theme SVG lacks from its compiled-in default.svg, so this file
# only states what the Platinum style changes. The palette values come from
# the MacOS8 color scheme (see theme/color-schemes/MacOS8.colors) and from the
# Platinum bevel palette; tests/test_kvantum_config.py re-derives every one of them.
#
# The global theme selects this style (`widgetStyle=kvantum` in its
# `contents/defaults`), and `make apply` runs
# `kvantummanager --set org.macos8.desktop`; without Kvantum installed the
# widgets fall back to another style.

[%General]
author=The kde-macos8.6-theme project
comment=Mac OS 8.6 Platinum widget style
scroll_width=16
scroll_arrows=true
composite=true

[GeneralColors]
window.color=#DDDDDD
button.color=#DDDDDD
mid.color=#DDDDDD
mid.light.color=#DDDDDD
base.color=#FFFFFF
alt.base.color=#EEEEEE
highlight.color=#CCCCFF
inactive.highlight.color=#CCCCFF
text.color=#000000
window.text.color=#000000
button.text.color=#000000
tooltip.text.color=#000000
highlight.text.color=#000000
disabled.text.color=#888888
tooltip.base.color=#FFFFCC
link.color=#0000EE
link.visited.color=#551A8B
light.color=#FFFFFF
dark.color=#999999

# The push and tool buttons: a 2px raised face (black outline, white
# top/left highlight, grey bottom/right shadow), black label in every state.
[PanelButtonCommand]
frame=true
frame.element=button
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=button
indicator.element=arrow
indicator.size=9
text.normal.color=#000000
text.focus.color=#000000
text.press.color=#000000
text.toggle.color=#000000

[PanelButtonTool]
inherits=PanelButtonCommand

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

# The reference popup's double up/down arrow in a 12x12 #DDDDDD cell
# (systeminfo_betawiki.png, the System Info "Show:" popup), not the shared
# single arrow the other indicator controls inherit.
[ComboBox]
inherits=PanelButtonCommand
indicator.element=comboarrow
indicator.size=12

[CheckBox]
inherits=PanelButtonCommand
interior.element=checkbox
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[RadioButton]
inherits=PanelButtonCommand
interior.element=radio
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[Focus]
inherits=PanelButtonCommand
interior=false
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common

[IndicatorArrow]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

# The track and value controls. The scroll bar track is 16px wide (the
# desktop theme's scrollbar.svg `hint-scrollbar-size`) and the slider and
# scrollbar trough is the flat #EEEEEE `slider` element the desktop theme's
# slider.svg and scrollbar.svg both draw, with a 1px #000000 outline. The
# slider/scrollbar thumb, the slider cursor and the spin box are raised
# #DDDDDD faces (2px margins), and the splitter is the thin 0/1 sliced line
# with a `splitter-grip` indicator.
[Scrollbar]
inherits=PanelButtonCommand
indicator.size=16

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior.element=scrollbarslider
indicator.element=grip
indicator.size=13

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=slider
frame.top=0
frame.bottom=0
frame.left=4
frame.right=4
interior.element=slider

[Slider]
inherits=PanelButtonCommand
frame.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior.element=slider

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior.element=progress
text.focus.color=white
text.bold=true

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior.element=progress-pattern

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=spin
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior.element=spin
indicator.element=arrow
indicator.size=9

[Splitter]
inherits=PanelButtonCommand
frame.element=splitter
frame.top=0
frame.bottom=0
frame.left=1
frame.right=1
interior.element=splitter
indicator.element=splitter-grip
indicator.size=16

# The container and text surfaces. Tabs (including Qt toolbox tabs), menus,
# the menu bar, group boxes, tooltips and toolbars are 2px raised Platinum
# faces; the item view is the
# white sunken field, and the menu and item-view selection is the flat
# #CCCCFF `[Colors:Selection] BackgroundNormal` the desktop theme's
# listitem.svg and viewitem.svg draw. The tooltip face is the #FFFFCC
# `[Colors:Tooltip] BackgroundNormal` role.
[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.margin.left=8
text.margin.right=8

[ToolboxTab]
inherits=Tab

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=common

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[MenuItem]
inherits=PanelButtonCommand
frame=false
interior.element=menuitem
indicator.element=menuitem
min_height=22
text.focus.color=#000000
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
text.margin.top=2
text.margin.bottom=2

[MenuBar]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
frame.top=0
frame.bottom=0
frame.left=2
frame.right=2

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
text.shadow=false
text.margin=0

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior.element=tooltip
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
text.shadow=false
text.margin=0

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[HeaderSection]
inherits=PanelButtonCommand

# The window's bottom-right grow box. No reference screenshot shows a
# KDE/Qt size grip, so this section and its key are Kvantum-required; the
# art adapts the grow box in systemprofiler_betawiki.png (platform
# adaptation 2026-10-26) and draws no frame or interior.
[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
frame.element=toolbar
interior.element=toolbar
indicator.element=toolbar
indicator.size=5

# The secondary controls Kvantum maps common Qt widgets to. No reference
# screenshot shows a KDE/Qt toolbar, tree view or status bar, so the section
# and key names here are Kvantum-required; every element they resolve to is
# the grounded Platinum art above. Toolbar buttons and split-button
# dropdowns are the 2px raised push button, the dropdown adding Kvantum's
# arrow-down indicator, toolbar combo boxes the combo box face with its 12px
# double arrow, and toolbar line edits the white sunken field. The tree
# expander draws only its black branch triangle, and the status bar is a flat
# window-face bar with no bevel.
[ToolbarButton]
inherits=PanelButtonCommand

[ToolbarComboBox]
inherits=ComboBox

[ToolbarLineEdit]
inherits=LineEdit

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[TreeExpander]
inherits=PanelButtonCommand
indicator.element=arrow
frame=false
interior=false

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

# The QDockWidget docking area. No reference screenshot shows a Qt dock
# panel, so this section is Kvantum-required (read 2026-10-27 from the
# installed KvantumAlt and KvAdapta themes, which define it); like
# [StatusBar] it draws nothing, so a dock panel's body keeps the flat
# #DDDDDD window face.
[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

# The QDockWidget header band (Qt's CE_DockWidgetTitle). No reference
# screenshot shows a Qt dock panel, so this section is Kvantum-required
# (read 2026-10-27 from the installed KvantumAlt and KvAdapta themes, which
# define it); the band is the menu-bar band read in Kvantum terms -- the
# #DDDDDD window face with a plain black label and the bottom edge's etched
# #FFFFFF-over-#888888 rule (widgets/line.svg, the GTK sheets' menubar
# bands, pinned by TestLineReference). The 0/2/0/0 frame margins, the 2/3
# text margins and the plain (non-bold) label are this theme's own choice:
# the reference set shows no dock header to sample them from.
[DockTitle]
inherits=PanelButtonCommand
frame=true
frame.element=dock
frame.top=0
frame.bottom=2
frame.left=0
frame.right=0
interior=false
text.normal.color=#000000
text.focus.color=#000000
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

# The QMdiSubWindow interior title bar (Qt's title band for child windows
# inside a QMdiArea). No reference screenshot shows a QMdiSubWindow, so
# this section is Kvantum-required (read 2026-10-27 from the four
# installed Kvantum themes -- KvantumAlt, KvAdapta, KvAmbiance and
# KvAmbience -- whose [TitleBar] sections all share this shape); the band
# is the bare #DDDDDD window face with a plain black label in both the
# normal and the focused state, with no frame and no rule. The face and
# label reuse the grounded [GeneralColors] window/text roles pinned by
# TestGeneralColors; the black focused label (every installed theme paints
# a light focused label), the flat no-rule band (interior nine-slice
# margins are not configurable keys, so a rule could not be pinned to the
# band's bottom edge the way [DockTitle]'s frame.bottom=2 pins its own)
# and the 2/2/3/3 text margins (KvantumAlt's, and [DockTitle]'s
# horizontal 3) are this theme's own choice. The window buttons resolve to
# the `mdi` indicator element, painted by our own eight `mdi` SVG groups.
# The two keys match the engine's compiled-in default [TitleBar] (read
# 2026-10-27 from upstream's default.kvconfig) and the installed KvantumAlt
# theme's, so they pin what the engine already resolves; the art is the
# Aurorae decoration's own reference-grounded box art, and the minimize
# mapping to the collapse box (no reference shows a minimize box), the
# dropped 13th-pixel highlight and the disabled greys are recorded choices
# beside the SVG groups. Declaration and SVG checks do not establish
# rendered Qt pixels.
[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.element=mdi
indicator.size=12
text.normal.color=#000000
text.focus.color=#000000
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3
